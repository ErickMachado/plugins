{
  "name": "asana",
  "displayName": "Asana",
  "version": "1.0.0",
  "minClientVersions": {
    "cursor": "3.13.0"
  },
  "description": "Create, search, and update tasks, projects, and portfolios.",
  "author": {
    "name": "Cursor",
    "email": "plugins@cursor.com"
  },
  "homepage": "https://developers.asana.com/docs/connecting-mcp-clients-to-asanas-v2-server#cursor",
  "repository": "https://github.com/cursor/plugins",
  "license": "MIT",
  "logo": "assets/logo.svg",
  "keywords": [
    "asana",
    "tasks",
    "projects",
    "portfolios",
    "productivity",
    "project management",
    "mcp"
  ],
  "category": "integrations",
  "tags": [
    "asana",
    "tasks",
    "mcp",
    "productivity"
  ],
  "variables": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "CLIENT_ID": {
        "type": "string",
        "title": "Asana Client ID",
        "description": "Client ID from your MCP app in the Asana developer console (https://app.asana.com/0/my-apps). The app type must be MCP app."
      },
      "CLIENT_SECRET": {
        "type": "string",
        "title": "Asana Client Secret",
        "description": "Client secret from the same Asana MCP app. Stored encrypted and never shown back.",
        "writeOnly": true,
        "format": "password"
      }
    },
    "required": [
      "CLIENT_ID",
      "CLIENT_SECRET"
    ]
  },
  "mcpServers": "./mcp.json"
}
